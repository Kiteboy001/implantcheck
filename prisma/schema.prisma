// Prisma 7 schema — datasource URL in prisma.config.ts

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// ── NextAuth.js v5 models ─────────────────────────────────────

model User {
  id            String         @id @default(uuid())
  name          String?
  email         String         @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  gdcNumber     String?        @map("gdc_number") // 5-8 digit GDC registration number
  role          Role           @default(SUBMITTER)

  // Relations
  accounts      Account[]
  sessions      Session[]
  submittedCases Case[]        @relation("Submitter")
  assignedCases  Case[]        @relation("ReviewerAssignment")
  reviews       Review[]       @relation("Reviewer")
  createdTokens Token[]        @relation("TokenCreator")
  usedTokens    Token[]        @relation("TokenUser")

  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  waiverAccepted Boolean       @default(false) @map("waiver_accepted")
  waiverAcceptedAt DateTime?   @map("waiver_accepted_at")

  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ── Domain models ──────────────────────────────────────────────

enum Role {
  SUBMITTER
  REVIEWER
  ADMIN
}

enum CaseTier {
  BASIC        // £95  — single implant
  STANDARD     // £199 — 2–4 implants with plan
  COMPLEX      // £295 — 4+ implants + Zoom call
  PILOT_GUIDE  // £399 — collaborative surgical pilot guide
}

enum CaseStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  NEEDS_REVISION
  REVISED
  REJECTED
}

enum PaymentStatus {
  UNPAID
  PAID
  TOKEN_REDEEMED
}

enum FileType {
  STL
  CBCT
  SCREENSHOT
  PLY
  OBJ
  OTHER
}

enum ReviewDecision {
  APPROVED
  NEEDS_REVISION
  REJECTED
}

model Case {
  id             String        @id @default(uuid())
  submitterId    String        @map("submitter_id")
  reviewerId     String?       @map("reviewer_id")
  tier           CaseTier      @default(BASIC)
  status         CaseStatus    @default(PENDING)
  paymentStatus  PaymentStatus @default(UNPAID) @map("payment_status")
  patientContext String?       @map("patient_context") // anonymised — no PII
  treatmentNotes String     @map("treatment_notes")
  softwareUsed   String?    @map("software_used") // e.g. "Blue Sky Bio"

  submitter User       @relation("Submitter", fields: [submitterId], references: [id])
  reviewer  User?      @relation("ReviewerAssignment", fields: [reviewerId], references: [id])
  files     CaseFile[]
  reviews   Review[]
  token     Token?     @relation("TokenCase")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("cases")
}

model CaseFile {
  id        String   @id @default(uuid())
  caseId    String   @map("case_id")
  fileUrl   String   @map("file_url")
  fileName  String   @map("file_name")
  fileType  FileType @map("file_type")
  fileSize  Int      @map("file_size")

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  uploadedAt DateTime @default(now()) @map("uploaded_at")

  @@map("case_files")
}

model Review {
  id               String         @id @default(uuid())
  caseId           String         @map("case_id")
  reviewerId       String         @map("reviewer_id")
  decision         ReviewDecision
  caseSummary      String?        @map("case_summary")
  sacClassification String?       @map("sac_classification") // Straightforward / Advanced / Complex
  implantPosition  String?        @map("implant_position")
  angulation       String?
  anatomicalConsiderations String? @map("anatomical_considerations")
  prostheticConsiderations String? @map("prosthetic_considerations")
  riskFlags        String?        @map("risk_flags")
  recommendations  String?
  overallFeedback  String         @map("overall_feedback")

  case     Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  reviewer User @relation("Reviewer", fields: [reviewerId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("reviews")
}

model ReportTemplate {
  id        String  @id @default(uuid())
  name      String  // e.g. "Standard Implant Review"
  sections  Json    // ordered array of {title, placeholder, required}
  isDefault Boolean @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("report_templates")
}

model Token {
  id         String       @id @default(uuid())
  code       String       @unique // e.g. "IC-A7B3-X9K2"
  tier       CaseTier     // which tier this token covers
  isUsed     Boolean      @default(false) @map("is_used")
  usedById   String?      @map("used_by_id")
  usedCaseId String?      @unique @map("used_case_id")
  usedAt     DateTime?    @map("used_at")
  createdById String      @map("created_by_id")
  notes      String?      // admin notes (e.g. "Cohort 3 student token")

  usedBy    User?  @relation("TokenUser", fields: [usedById], references: [id])
  usedCase  Case?  @relation("TokenCase", fields: [usedCaseId], references: [id])
  createdBy User   @relation("TokenCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@map("tokens")
}
